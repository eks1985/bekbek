# ── База данных ─────────────────────────────────────────────
# DEV (локальный Postgres):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth"
#
# PROD (база Layero): на Layero строка подключения приезжает сама в
# LAYERO_DATABASE_URL — приложение берёт её первой, DATABASE_URL задавать
# в проекте не нужно. Локально LAYERO_DATABASE_URL не задавайте — иначе
# dev-сервер и `db:migrate` пойдут в прод-базу. TLS: sslmode уже в строке,
# сертификат Let's Encrypt проверяется по системным корням, CA-файл не нужен.
# Размер пула задаётся в коде (max=3, src/lib/db.ts), не в URL.

# ── Сессия ──────────────────────────────────────────────────
# true в проде (HTTPS): cookie ставится с префиксом __Host-.
# false локально по http, иначе cookie не поставится.
SESSION_COOKIE_SECURE="false"

# ── Почта ───────────────────────────────────────────────────
# console (по умолчанию) — код печатается в лог сервера, без аккаунта.
# notisend — реальная отправка через Notisend HTTP API.
MAILER="notisend"

# Нужны только при MAILER=notisend:
NOTISEND_API_KEY="<ключ из панели Notisend>"
MAIL_FROM="noreply@maschio-gaspardo.ru"
MAIL_FROM_NAME="Вход"

# Базовый URL приложения.
APP_URL="http://localhost:3000"

# ── MCP (/api/mcp) ──────────────────────────────────────────
# Временный сервисный ключ на время тестов: открывает данные ЛЮБОГО
# пользователя, какого — задаёт ?user=<email> или MCP_DEFAULT_USER_EMAIL.
# Пусто — эндпоинт выключен (404). Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Коннектор claude.ai: https://<домен>/api/mcp?key=<ключ>&user=<email>
MCP_SERVICE_KEY=""
MCP_DEFAULT_USER_EMAIL=""

# ── Selectel S3 (FIT-файлы) ─────────────────────────────────
# Приватный бакет; ключи — S3-ключ сервисного пользователя.
# Локально — в .env.local, в проде — переменные проекта на Layero.
S3_ENDPOINT="https://s3.ru-1.storage.selcloud.ru"
S3_REGION="ru-1"
S3_BUCKET="<имя бакета>"
S3_ACCESS_KEY_ID="<access key>"
S3_SECRET_ACCESS_KEY="<secret key>"

# ── Garmin (garmin-sync на VPS, см. garmin-sync/README.md) ──
GARMIN_SYNC_URL="https://garmin.terravitafze.com"
GARMIN_SYNC_TOKEN="<общий секрет с garmin-sync>"
# /api/garmin/* доступен только с этого email (один аккаунт Garmin — один владелец)
GARMIN_OWNER_EMAIL="<твой email входа в bek-bek>"
