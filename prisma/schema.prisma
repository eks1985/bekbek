// Схема БД для email-OTP авторизации.
// Боевая база — PostgreSQL на Layero, локально — свой Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: строка подключения задаётся не здесь, а через driver adapter
  // (@prisma/adapter-pg) в рантайме и prisma.config.ts для миграций.
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique // всегда в нижнем регистре
  createdAt DateTime  @default(now())
  sessions  Session[]
  fitFiles  FitFile[]
  workouts  Workout[]

  @@map("users")
}

/// Загруженный FIT-файл. Сам файл лежит в Selectel S3, здесь — ключ объекта.
model FitFile {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey   String   @unique // напр. "fit/<userId>/<id>.fit"
  originalName String // имя файла у пользователя
  sizeBytes    Int
  sha256       String // хеш содержимого — чтобы не загрузить один файл дважды
  uploadedAt   DateTime @default(now())
  workout      Workout?

  source           String  @default("upload") // "upload" | "garmin"
  garminActivityId String? // id активности в Garmin Connect — есть только у source="garmin"

  @@unique([userId, sha256])
  @@unique([userId, garminActivityId])
  @@index([userId, uploadedAt])
  @@map("fit_files")
}

/// Результат парсинга FIT-файла (без посекундных точек).
/// Весь результат — в data (jsonb), поля для фильтров продублированы колонками.
/// Новый фильтр = новая колонка + миграция, заполняющая её из data.
model Workout {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitFileId String  @unique // один файл — один результат; повторный разбор перезаписывает
  fitFile   FitFile @relation(fields: [fitFileId], references: [id], onDelete: Cascade)

  title String? // название от пользователя; null — показываем дату и тег

  // Колонки для фильтров и сортировки — копии полей из data.summary
  startTime       DateTime // summary.startTime (UTC)
  sport           String?
  distanceM       Float?
  durationSec     Float?
  avgPaceSecPerKm Float?
  avgHeartRate    Int?
  workoutTag      String?

  data          Json // ParsedWorkout без points
  parserVersion Int // растёт при смене формата data — видно, что переразбирать

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startTime])
  @@index([userId, workoutTag])
  @@index([userId, distanceM])
  @@map("workouts")
}

/// Одноразовые коды входа. Хранится только хеш кода, не сам код.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String // sha256(email + ':' + code)
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
  @@map("login_codes")
}

/// Серверные сессии. В cookie лежит сырой токен, в БД — его sha256.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Счётчик обращений для rate-limit (по email и по IP).
model RateHit {
  id        String   @id @default(cuid())
  bucket    String // напр. "request-code:email" или "request-code:ip"
  key       String // email или ip
  createdAt DateTime @default(now())

  @@index([bucket, key, createdAt])
  @@map("rate_hits")
}
