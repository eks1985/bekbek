# Папка с токенами Garmin (garmin_tokens.json). На сервере — volume: /data/tokens
GARMIN_TOKEN_DIR=./data/tokens
# Куда класть скачанные .fit. На сервере — /data/fit
GARMIN_FIT_DIR=./data/fit
# SQLite: что уже скачано + last_sync_at. На сервере — /data/garmin.db
GARMIN_DB_PATH=./data/garmin.db

# Общий секрет с bek-bek (Authorization: Bearer ...). Пустой = всё, кроме
# /health, всегда 401
GARMIN_SYNC_TOKEN=

# Активности раньше этой даты не качаем ("2026-09-01"; пусто = качать всё)
GARMIN_IMPORT_FROM=2026-09-01
# Сколько последних активностей запрашивать за один синк
GARMIN_LIST_LIMIT=20
# Не чаще раза в столько секунд ходить в Garmin
GARMIN_SYNC_MIN_INTERVAL_SEC=60
# Попыток скачать неудавшуюся активность
GARMIN_MAX_ATTEMPTS=3
